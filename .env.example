# Freemius product-scope credentials (see docs/specs §8)
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=

# Optional: enable product-scope signed URLs (e.g. invoice PDF download)
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=

# MCP write opt-in. Unset/0 = read-only (default). 1 = allow mutating tools.
FREEMIUS_MCP_ALLOW_WRITE=0
