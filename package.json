{
  "name": "@eventimio/freemius-mcp",
  "version": "0.0.0",
  "description": "Community CLI + MCP server for the Freemius product API. Not affiliated with Freemius.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "freemius": "dist/cli/index.js",
    "freemius-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:cli": "bun run src/cli/index.ts",
    "dev:mcp": "bun run src/mcp/index.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "generate": "bun run scripts/generate.ts",
    "fetch-spec": "bun run scripts/fetch-spec.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@freemius/sdk": "0.3.0",
    "@freemius/checkout": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
