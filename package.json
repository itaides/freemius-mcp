{
    "name": "@eventimio/freemius-mcp",
    "version": "0.1.0",
    "description": "Community CLI + MCP server for the Freemius product API. Not affiliated with Freemius.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.3.14",
    "bin": {
        "freemius": "dist/cli/index.js",
        "freemius-mcp": "dist/mcp/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev:cli": "bun run src/cli/index.ts",
        "dev:mcp": "bun run src/mcp/index.ts",
        "build": "bun run scripts/build.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p src/mcp/ui/revenue/app/tsconfig.json && tsc --noEmit -p src/mcp/ui/coupon/app/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "generate": "bun run scripts/generate.ts",
        "generate:ui": "bun run scripts/build-ui.ts",
        "fetch-spec": "bun run scripts/fetch-spec.ts",
        "prepublishOnly": "bun run generate:ui && bun run build"
    },
    "dependencies": {
        "@freemius/sdk": "0.3.0",
        "@freemius/checkout": "^1.4.1",
        "@modelcontextprotocol/ext-apps": "1.7.3",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "commander": "^15.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@types/node": "^25.9.1",
        "msw": "^2.14.6",
        "openapi-typescript": "^7.13.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    }
}
