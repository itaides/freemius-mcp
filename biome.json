{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!src/core/schema.d.ts",
            "!src/core/catalog.ts",
            "!src/mcp/ui/revenue/generated/dashboard-html.ts",
            "!src/mcp/ui/coupon/generated/coupon-form-html.ts",
            "!src/mcp/ui/customer/generated/profile-html.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "es5"
        }
    },
    "linter": {
        "enabled": true,
        "rules": { "recommended": true }
    }
}
